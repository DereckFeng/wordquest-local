# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
*.tsbuildinfo
/.wrangler/
/.audio-venv/
/.mfa-env/
/.mfa-env312/
/.tts-venv/
/.tts-cache/
/models/
/outputs/
/work/

# Private/local learning materials and generated derivatives.
# These directories may contain licensed course PDFs, extracted text, original
# recordings, sentence clips, OCR/ASR output, QA reports, or personal progress.
/RAZ Book/
/RAZ Audio/
/data/
/public/raz-audio/
/tmp/

# Keep media and document sources out even when placed elsewhere by mistake.
*.pdf
*.mp3
*.mp4
*.m4a
*.wav
*.aiff
*.flac
*.TextGrid
